{
  "name": "auu-ahh-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "lint:workflows": "node scripts/tools.mjs lint",
    "tools:install": "node scripts/tools.mjs install",
    "security:secrets": "node scripts/security.mjs",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/order.test.ts tests/release.test.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
